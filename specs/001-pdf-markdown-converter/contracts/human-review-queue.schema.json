{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solari.local/schemas/human-review-queue-2.0.json",
  "title": "HumanReviewQueue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "schema_version", "run_id", "tool_version",
    "source_pdf", "source_sha256", "page_selection", "items", "summary"
  ],
  "properties": {
    "record_type": { "const": "human_review_queue" },
    "schema_version": { "const": "2.0" },
    "run_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "tool_version": { "type": "string", "minLength": 1 },
    "source_pdf": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "page_selection": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "conflict_type", "status", "physical_page", "region_bboxes",
          "contributing_sources", "reason", "confidence", "candidates"],
        "properties": {
          "id": { "type": "string", "minLength": 1,
            "description": "Deterministic from the applicability key (research §22)." },
          "conflict_type": { "enum": ["literal_content", "reading_order"] },
          "status": { "enum": ["open", "resolved"] },
          "physical_page": { "type": "integer", "minimum": 1 },
          "region_bboxes": {
            "type": "array", "minItems": 1,
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
          },
          "contributing_sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "markdown_line": { "type": "integer", "minimum": 1 },
          "markdown_column": { "type": "integer", "minimum": 1 },
          "candidates": {
            "type": "array", "minItems": 1,
            "description": "literal_content (FR-062a): [{technique, value, ocr_confidence?}]. reading_order (FR-062d): [{technique, order:[segment_id]}] and see segment_ids.",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["technique"],
              "properties": {
                "technique": { "type": "string", "minLength": 1 },
                "value": { "type": "string" },
                "order": { "type": "array", "items": { "type": "string" } },
                "ocr_confidence": { "type": ["number", "null"] }
              }
            }
          },
          "segment_ids": {
            "type": "array", "items": { "type": "string" },
            "description": "reading_order items only: the exact segment set an --order resolution must permute (FR-062d/FR-069)."
          }
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["open", "resolved"],
      "properties": {
        "open": { "type": "integer", "minimum": 0 },
        "resolved": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
